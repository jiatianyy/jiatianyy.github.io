{
  "name": "jiatian-yuan-academic-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "verify": "node scripts/verify.mjs",
    "validate": "npm run check:research && npm run check && npm run build && npm run verify",
    "sync:research": "node scripts/sync-research.mjs",
    "check:research": "node scripts/sync-research.mjs --check",
    "build:review": "astro build --mode review"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/markdown-remark": "^7.3.6",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3",
    "cheerio": "^1.1.2"
  },
  "overrides": { "katex": "^0.19.1" },
  "engines": { "node": ">=24.0.0" }
}
