---
import Base from '../layouts/Base.astro';
import LoopDiagram from '../components/LoopDiagram.astro';
import { directions } from '../data/site';
---
<Base>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow"><span class="small-dot"></span> Personal academic website</p><h1>Jiatian Yuan<span class="hero-subtitle">Exploring learning,<br />memory, and reasoning.</span></h1><p class="lede">Research interests at the intersection of iterative computation, language model reasoning, and efficient learning.</p><div class="actions"><a class="button" href="/research/">Explore research <span>↗</span></a><a class="text-link" href="/about/">About / CV <span>→</span></a></div><p class="profile-pending">Affiliation & biography · To be added</p></div>
    <LoopDiagram />
  </section>
  <section class="section-block"><div class="section-top"><div><p class="eyebrow">01 / Research interests</p><h2>Three connected directions.</h2></div><a class="text-link" href="/research/">View research →</a></div><div class="direction-grid">{directions.map(d => <a class="direction-card" href={`/research/#${d.id}`}><div class="card-meta"><span>{d.number}</span><span>{d.tag}</span></div><h3>{d.title}</h3><p>{d.description}</p><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div></section>
  <section class="section-block notebook-section"><div><p class="eyebrow">02 / The research notebook</p><h2>Room for the<br /><em>thinking in between.</em></h2><p>Reading notes, derivations, and experiments.<br />A place to make ideas easier to revisit.</p><a class="text-link" href="/notes/">Open the notebook →</a></div><div class="notebook-empty"><span class="notebook-symbol" aria-hidden="true">∑</span><h3>The notebook is taking shape.</h3><p>Reviewed research notes will appear here.<br />No research notes have been published yet.</p><span class="label">Awaiting first entry</span></div></section>
  <section class="section-block compact-links"><a href="/publications/"><span class="eyebrow">03 / Publications</span><h3>Papers & preprints <span>↗</span></h3><p>Verified publications will be listed here.</p></a><a href="/projects/"><span class="eyebrow">04 / Projects</span><h3>Ideas into experiments <span>↗</span></h3><p>Research software and project details to follow.</p></a></section>
</Base>
