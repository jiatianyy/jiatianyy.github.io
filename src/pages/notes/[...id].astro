---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import { getNotes } from '../../data/notes';
export async function getStaticPaths() { return (await getNotes()).map(note => ({ params: { id: note.id }, props: { note } })); }
interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={note.data.title} description={note.data.description}>
<PageHeading label="Research notebook" title={note.data.title} description={note.data.description} />
{(note.data.draft || !note.data.approved || note.data.kind === 'demo') && <div class="review-banner">Technical demonstration / unreviewed draft. This page demonstrates website features and makes no claim of original research. Excluded from production.</div>}
<div class="article-grid"><article class="prose"><p class="note-meta">{note.data.kind === 'demo' ? 'Demo created' : 'Entry date'} · {note.data.date.toISOString().slice(0, 10)}</p><Content />
{note.data.references.length > 0 && <section id="references"><h2>References</h2><ol>{note.data.references.map(ref => <li id={`ref-${ref.id}`}><a href={ref.url}>{ref.title} ↗</a>{ref.bibtex && <details><summary>BibTeX</summary><pre><code>{ref.bibtex}</code></pre></details>}</li>)}</ol></section>}
</article><aside class="toc" aria-label="On this page"><p class="eyebrow">On this page</p><ol>{toc.map(h => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}{note.data.references.length > 0 && <li><a href="#references">References</a></li>}</ol><a class="text-link" href="/notes/">← All notes</a></aside></div>
</Base>
